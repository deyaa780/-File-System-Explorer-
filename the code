using System;
using System.Collections.Generic;
using System.Linq;

namespace FileSystemExplorer
{
    /// <summary>
    /// Main program class that demonstrates the File System Explorer application.
    /// This program showcases four different data structures working together:
    /// - Tree structure for directories (hierarchical organization)
    /// - Doubly Linked List for files within each directory
    /// - Stack for navigation history (LIFO - Last In First Out)
    /// - Queue for recent items (FIFO - First In First Out)
    /// </summary>
    internal class Program
    {
        /// <summary>
        /// Entry point of the application. Demonstrates all features of the file system.
        /// </summary>
        /// <param name="args">Command line arguments (not used)</param>
        static void Main(string[] args)
        {
            Console.WriteLine("=== FILE SYSTEM EXPLORER ===\n");
            Console.WriteLine("A demonstration of multiple data structures working together:\n");
            Console.WriteLine("  🌳 Tree - Directory hierarchy");
            Console.WriteLine("  🔗 Doubly Linked List - Files in each directory");
            Console.WriteLine("  📚 Stack - Navigation history (LIFO)");
            Console.WriteLine("  ⏱️ Queue - Recent items (FIFO)\n");

            // Create our file system instance
            FileSystem fs = new FileSystem();

            // =========================================================================
            // 1. 🌳 TREE DEMONSTRATION - Creating directory structure
            //    Shows hierarchical parent-child relationships
            // =========================================================================
            Console.WriteLine("\n" + new string('=', 60));
            Console.WriteLine("📂 PART 1: TREE STRUCTURE - Creating Directories");
            Console.WriteLine(new string('=', 60));
            
            // Create top-level directories under Root
            fs.CurrentDirectory.AddSubdirectory("Documents");
            fs.CurrentDirectory.AddSubdirectory("Pictures");
            fs.CurrentDirectory.AddSubdirectory("Music");

            // Navigate to Documents and create subdirectories
            fs.ChangeDirectory("Documents");
            fs.CurrentDirectory.AddSubdirectory("Projects");
            fs.CurrentDirectory.AddSubdirectory("University");
            fs.CurrentDirectory.AddSubdirectory("Personal");

            // Navigate to Projects and add more depth to the tree
            fs.ChangeDirectory("Projects");
            fs.CurrentDirectory.AddSubdirectory("C#");
            fs.CurrentDirectory.AddSubdirectory("Python");

            // Go back to Documents to continue demonstrations
            fs.GoToParent(); // Back to Documents

            // =========================================================================
            // 2. 🔗 LINKED LIST DEMONSTRATION - Adding files to current directory
            //    Each directory maintains its OWN doubly linked list of files
            // =========================================================================
            Console.WriteLine("\n" + new string('=', 60));
            Console.WriteLine("📄 PART 2: DOUBLY LINKED LIST - Adding Files to Documents");
            Console.WriteLine(new string('=', 60));
            
            // Add files to Documents directory (creates a linked list)
            fs.AddFile("essay.docx", 50);
            fs.AddFile("notes.txt", 5);
            fs.AddFile("presentation.pptx", 200);
            fs.AddFile("budget.xlsx", 30);

            // Demonstrate forward traversal through the linked list
            Console.WriteLine("\n📋 Files in Documents (forward traversal using Next pointers):");
            File current = fs.CurrentDirectory.FirstFile;
            int fileCount = 1;
            while (current != null)
            {
                Console.WriteLine($"  {fileCount}. 📄 {current.Name} ({current.Size}KB) - Created: {current.CreatedDate.ToShortTimeString()}");
                Console.WriteLine($"     Next: {(current.Next != null ? current.Next.Name : "null")}");
                current = current.Next;
                fileCount++;
            }

            // Navigate to Projects and add different files (demonstrates separate linked lists)
            fs.ChangeDirectory("Projects");
            
            Console.WriteLine("\n" + new string('=', 60));
            Console.WriteLine("📄 Adding Files to Projects (Separate Linked List)");
            Console.WriteLine(new string('=', 60));
            
            fs.AddFile("program.cs", 15);
            fs.AddFile("algorithm.cs", 45);
            fs.AddFile("data.cs", 25);

            // =========================================================================
            // 3. 📚 STACK DEMONSTRATION - Navigation history
            //    Shows LIFO (Last In First Out) behavior
            // =========================================================================
            Console.WriteLine("\n" + new string('=', 60));
            Console.WriteLine("🧭 PART 3: STACK - Navigation History (LIFO)");
            Console.WriteLine(new string('=', 60));
            Console.WriteLine("Let's navigate around and see the stack in action...\n");

            // Perform various navigation operations to build the stack
            fs.ChangeDirectory("C#");           // Documents/Projects/C#
            fs.GoToParent();                     // Back to Projects
            fs.ChangeDirectory("Python");        // Documents/Projects/Python
            fs.GoToParent();                      // Back to Projects  
            fs.GoToParent();                      // Back to Documents
            fs.ChangeDirectory("University");    // Documents/University

            // Display the navigation stack (most recent at top)
            Console.WriteLine("\n📚 Navigation Stack (Top = Most Recent):");
            Stack<Directory> history = fs.History.GetNavigationHistory();
            int stackIndex = 1;
            foreach (var dir in history)
            {
                Console.WriteLine($"  {stackIndex}. 📁 {dir.Name} (Level {dir.Level})");
                stackIndex++;
            }

            // =========================================================================
            // 4. ⏱️ QUEUE DEMONSTRATION - Recent items
            //    Shows FIFO (First In First Out) behavior with a fixed size of 5
            // =========================================================================
            Console.WriteLine("\n" + new string('=', 60));
            Console.WriteLine("⏱️ PART 4: QUEUE - Recent Items (FIFO - Last 5 Items)");
            Console.WriteLine(new string('=', 60));
            fs.History.ShowRecentItems();

            // =========================================================================
            // 5. 📊 CURRENT STATE DISPLAY
            //    Shows everything in the current directory
            // =========================================================================
            Console.WriteLine("\n" + new string('=', 60));
            Console.WriteLine("📊 CURRENT DIRECTORY STATE");
            Console.WriteLine(new string('=', 60));
            fs.DisplayCurrentDirectory();

            // =========================================================================
            // 6. 🔄 ADVANCED LINKED LIST OPERATIONS
            //    Demonstrates bidirectional traversal and deletion
            // =========================================================================
            Console.WriteLine("\n" + new string('=', 60));
            Console.WriteLine("🔄 PART 5: ADVANCED LINKED LIST OPERATIONS");
            Console.WriteLine(new string('=', 60));

            // Navigate to Projects to work with its linked list
            fs.GoToParent(); // Back to Documents
            fs.ChangeDirectory("Projects");

            Console.WriteLine($"\nCurrent directory: {fs.GetCurrentPath()}");

            // Forward traversal demonstration
            Console.WriteLine("\n➡️ Forward traversal (using Next pointers):");
            current = fs.CurrentDirectory.FirstFile;
            while (current != null)
            {
                Console.WriteLine($"  → {current.Name}");
                current = current.Next;
            }

            // Backward traversal demonstration (shows doubly linked feature)
            Console.WriteLine("\n⬅️ Backward traversal (using Previous pointers):");
            current = fs.CurrentDirectory.LastFile;
            while (current != null)
            {
                Console.WriteLine($"  ← {current.Name}");
                current = current.Previous;
            }

            // =========================================================================
            // 7. 🗑️ LINKED LIST DELETION DEMONSTRATION
            //    Shows how to remove a node and update pointers
            // =========================================================================
            Console.WriteLine("\n" + new string('=', 60));
            Console.WriteLine("🗑️ PART 6: LINKED LIST DELETION");
            Console.WriteLine(new string('=', 60));
            
            Console.WriteLine("\nRemoving 'program.cs' from Projects directory...");
            fs.CurrentDirectory.RemoveFile("program.cs");

            Console.WriteLine("\n📋 Files in Projects after deletion:");
            current = fs.CurrentDirectory.FirstFile;
            fileCount = 1;
            while (current != null)
            {
                Console.WriteLine($"  {fileCount}. {current.Name}");
                current = current.Next;
                fileCount++;
            }

            // =========================================================================
            // 8. 🔍 LINKED LIST SEARCH DEMONSTRATION
            //    Shows linear search through the linked list
            // =========================================================================
            Console.WriteLine("\n" + new string('=', 60));
            Console.WriteLine("🔍 PART 7: LINKED LIST SEARCH");
            Console.WriteLine(new string('=', 60));
            
            File found = fs.CurrentDirectory.FindFile("algorithm.cs");
            if (found != null)
                Console.WriteLine($"\n✅ Found: {found.Name} ({found.Size}KB)");
            else
                Console.WriteLine("\n❌ File not found");

            // =========================================================================
            // 9. 🎯 FINAL SUMMARY
            // =========================================================================
            Console.WriteLine("\n" + new string('=', 60));
            Console.WriteLine("✅ PROJECT SUMMARY");
            Console.WriteLine(new string('=', 60));
            Console.WriteLine("\nAll four data structures demonstrated successfully:\n");
            Console.WriteLine("  ✓ 🌳 TREE: Directory hierarchy with parent-child relationships");
            Console.WriteLine("  ✓ 🔗 LINKED LIST: Files in each directory with Next/Previous pointers");
            Console.WriteLine("  ✓ 📚 STACK: Navigation history with LIFO behavior");
            Console.WriteLine("  ✓ ⏱️ QUEUE: Recent items with FIFO behavior and fixed size");
            Console.WriteLine("\n🎉 File System Explorer completed successfully!");
        }
    }

